{
  "$schema": "./node_modules/nx/schemas/workspace-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default", "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x).(.snap|[jt]sx)?(.snap)"],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "serve": {
      "cache": false
    }
  },
  "plugins": [
    {
      "plugin": "nx-go",
      "options": {
        "goPath": "api"
      }
    }
  ],
  "defaultProject": "app",
  "projects": {
    "app": {
      "root": "app",
      "targets": {
        "serve": {
          "executor": "@nx/expo:start",
          "options": {
            "port": 8081
          },
          "configurations": {
            "web": {
              "platform": "web"
            },
            "android": {
              "platform": "android"
            },
            "ios": {
              "platform": "ios"
            }
          },
          "defaultConfiguration": "web"
        },
        "build": {
          "executor": "@nx/expo:build",
          "options": {},
          "configurations": {
            "production": {}
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "executor": "@nx/jest:jest",
          "options": {
            "jestConfig": "app/jest.config.js",
            "passWithNoTests": true
          }
        }
      }
    },
    "api": {
      "root": "api",
      "targets": {
        "serve": {
          "executor": "nx-go:run",
          "options": {
            "main": "cmd/api/main.go"
          }
        },
        "build": {
          "executor": "nx-go:build",
          "options": {}
        },
        "test": {
          "executor": "nx-go:test",
          "options": {}
        },
        "migrate": {
          "executor": "nx:run-commands",
          "options": {
            "command": "docker-compose -f docker/docker-compose.yml up db && sleep 5 && docker exec recipevault-db-1 psql -U recipevault -d recipevault -f /docker-entrypoint-initdb.d/001_initial_schema.sql || echo 'Migration skipped'",
            " cwd": "."
          }
        }
      }
    }
  }
}