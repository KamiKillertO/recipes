{
  "$schema": "./node_modules/nx/schemas/workspace-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default", "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x).(.snap|[jt]sx)?(.snap)"],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "serve": {
      "cache": false
    }
  },
  "plugins": [
    {
      "plugin": "nx-go",
      "options": {
        "goPath": "api"
      }
    }
  ],
  "defaultProject": "app",
  "projects": {
    "app": {
      "root": "app",
      "targets": {
        "serve": {
          "executor": "@nx/expo:serve",
          "options": {
            "port": 8081
          },
          "configurations": {
            "production": {}
          },
          "defaultConfiguration": "production"
        },
        "build": {
          "executor": "@nx/expo:build",
          "options": {},
          "configurations": {
            "production": {}
          }
        }
      }
    },
    "api": {
      "root": "api",
      "targets": {
        "serve": {
          "executor": "nx-go:serve",
          "options": {
            "port": 8080
          }
        },
        "build": {
          "executor": "nx-go:build",
          "options": {}
        },
        "test": {
          "executor": "nx-go:test",
          "options": {}
        }
      }
    }
  }
}