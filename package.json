{
  "name": "recipevault",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "npm run start:web",
    "start:web": "cd app && npx expo start --web",
    "start:android": "cd app && npx expo start --android",
    "start:ios": "cd app && npx expo start --ios",
    "start:api": "cd api && go run ./cmd/api",
    "start:all": "npm run docker:up && concurrently \"npm run start:api\" \"npm run start:web\"",
    "build": "npm run build:api && npm run build:app",
    "build:api": "cd api && go build -o bin/api ./cmd/api",
    "build:app": "cd app && npx expo export --platform web",
    "test": "npm run test:api",
    "test:api": "cd api && go test ./...",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:rebuild": "docker compose -f docker/docker-compose.yml up -d --build",
    "dev": "npm run start:all"
  },
  "devDependencies": {
    "@expo/cli": "~54.0.16",
    "@nx-go/nx-go": "^4.0.0",
    "@nx/docker": "22.7.1",
    "@nx/expo": "22.7.1",
    "@nx/react-native": "22.7.1",
    "concurrently": "^9.1.0",
    "metro-config": "~0.83.0",
    "metro-resolver": "~0.83.0",
    "nx": "22.7.1"
  },
  "nx": {},
  "allowScripts": {
    "detox@20.51.4": true,
    "nx@22.7.1": true,
    "dtrace-provider@0.8.8": true,
    "unrs-resolver@1.11.1": true
  }
}
