{
  "name": "recipevault",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev:web": "nx run app:serve",
    "dev:api": "nx run api:serve",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "start:web": "nx run app:serve",
    "start:api": "nx run api:serve",
    "start:all": "npm run docker:up && concurrently \"npm run start:api\" \"npm run start:web\"",
    "build": "npm run build:api && nx run app:build",
    "build:api": "nx run api:build",
    "build:app": "nx run app:build",
    "test": "npm run test:api",
    "test:api": "nx run api:test",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:rebuild": "docker compose -f docker/docker-compose.yml up -d --build",
    "test:browser": "vitest"
  },
  "devDependencies": {
    "@nx-go/nx-go": "^4.1.1",
    "@nx/docker": "22.7.1",
    "@nx/js": "22.7.1",
    "@nx/vite": "^22.7.1",
    "@nx/web": "22.7.1",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/ui": "~4.1.0",
    "concurrently": "^9.1.0",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "nx": "22.7.1",
    "prettier": "~3.6.2",
    "typescript": "~5.9.2",
    "vite": "^8.0.0",
    "vitest": "~4.1.0",
    "vitest-browser-lit": "^1.0.1"
  },
  "nx": {},
  "allowScripts": {
    "nx@22.7.1": true,
    "dtrace-provider@0.8.8": true,
    "unrs-resolver@1.11.1": true,
    "@swc/core@1.15.47": true
  }
}
